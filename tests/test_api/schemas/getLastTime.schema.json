{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bookid",
    "name",
    "img",
    "filenum",
    "time",
    "opened"
  ],
  "properties": {
    "bookid": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "img": {
      "type": "string",
      "minLength": 1
    },
    "filenum": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "opened": {
      "type": "integer",
      "enum": [0, 1]
    }
  }
}
